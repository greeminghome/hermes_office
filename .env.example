# Copy to .env with ./deploy/scripts/install.sh. Never commit the generated .env.
COMPOSE_PROJECT_NAME=hermes-office
HERMES_OFFICE_IMAGE=hermes-office:local
HERMES_OFFICE_DEPLOY_MODE=build
HERMES_RUNTIME_UID=1000
HERMES_RUNTIME_GID=1000

# Public URL and local bind. Use HTTPS except for local-only evaluation.
PUBLIC_ORIGIN=https://office.example.com
PUBLIC_ORIGIN_HOST=office.example.com
COOKIE_SECURE=true
HERMES_OFFICE_BIND=127.0.0.1
HERMES_OFFICE_PORT=4173

# The installer replaces all CHANGE_ME values.
HERMES_OFFICE_USER=admin
HERMES_OFFICE_PASSWORD_HASH=CHANGE_ME_INSTALLER_GENERATES_THIS
HERMES_OFFICE_SESSION_SECRET=CHANGE_ME_INSTALLER_GENERATES_THIS
RESERVATION_AGENT_READ_TOKEN=CHANGE_ME_INSTALLER_GENERATES_THIS

# Hermes Agent. The default reaches a host-published Agent port on Linux.
HERMES_TARGET=http://host.docker.internal:9119
HERMES_AUTH_MODE=official
HERMES_AUTH_PROVIDER=basic

# Add deploy/docker-compose.agent-network.yml when Agent is on another Docker network.
HERMES_AGENT_NETWORK=

# Live Screen is disabled until its CDP endpoints are explicitly configured.
LIVE_SCREEN_CDP_URL=
LIVE_SCREEN_PROFILE_CDP_URLS=
LIVE_SCREEN_ALLOWED_PROFILES=default,greeming-doyun,greeming-harin,greeming-jaehyun,greeming-jian,greeming-junseo,greeming-minjun,greeming-seoyun,greeming-taeo,greeming-yuna

# Optional reverse proxy overlay.
TRAEFIK_ENABLE=false
TRAEFIK_NETWORK=traefik
TRAEFIK_CERT_RESOLVER=letsencrypt

# Optional bridges. Leave both target and token empty when unused.
INSTAGRAM_BRIDGE_TARGET=
INSTAGRAM_BRIDGE_ADMIN_TOKEN=

# Google Drive files are loaded only after new OAuth files are placed in deploy/secrets.
HERMES_GOOGLE_TOKEN_PATH=/run/secrets/google_office_readonly_token.json
HERMES_GOOGLE_CLIENT_SECRET_PATH=/run/secrets/google_client_secret.json
GOOGLE_DRIVE_SYNC_INTERVAL_MS=300000
GOOGLE_DRIVE_SYNC_MAX_ITEMS=5000

# Reservation synchronization starts fail-closed. Enable one writer at a time after read-only verification.
RESERVATION_TIME_ZONE=Asia/Seoul
RESERVATION_VENUE_ID=hermes-office
RESERVATION_VENUE_NAME=Hermes Office
RESERVATION_RESOURCE_ID=main-space
RESERVATION_SYNC_ENABLED=false
RESERVATION_WRITE_MODE=shadow
RESERVATION_GOOGLE_WRITE_ENABLED=false
RESERVATION_HOURPLACE_FEED_ENABLED=false
RESERVATION_HOURPLACE_FEED_TOKEN=
RESERVATION_NAVER_AVAILABILITY_ENABLED=false
RESERVATION_SPACECLOUD_WRITE_ENABLED=false
RESERVATION_BROWSER_CDP_URL=
RESERVATION_BROWSER_HEALTH_MS=300000
RESERVATION_NAVER_BIZ_ID=
RESERVATION_NAVER_PRODUCT_ID=
RESERVATION_NAVER_PRODUCT_NAME=
RESERVATION_NAVER_MINIMUM_DURATION_MINUTES=120
RESERVATION_SPACECLOUD_PRODUCT_ID=
RESERVATION_SPACECLOUD_SPACE_ID=
RESERVATION_GMAIL_INGEST_ENABLED=false
RESERVATION_GMAIL_TOPIC=
RESERVATION_GMAIL_PUSH_AUDIENCE=
RESERVATION_GMAIL_PUSH_SERVICE_ACCOUNT=
RESERVATION_GMAIL_POLL_MS=120000
RESERVATION_ICAL_POLL_MS=120000
RESERVATION_RECONCILE_MS=900000
RESERVATION_PENDING_BLOCKS=false
RESERVATION_BUFFER_BEFORE_MINUTES=0
RESERVATION_BUFFER_AFTER_MINUTES=0
RESERVATION_TELEGRAM_ENABLED=false
RESERVATION_TELEGRAM_SECRET_PATH=/run/secrets/telegram.json

RESERVATION_AGENT_ALLOWED_PROFILES=default,greeming-doyun,greeming-harin,greeming-jaehyun,greeming-jian,greeming-junseo,greeming-minjun,greeming-seoyun,greeming-taeo,greeming-yuna
DATA_ROOM_MAX_FILES=10000
DEPLOYMENT_BACKUP_ROOT=./backups
